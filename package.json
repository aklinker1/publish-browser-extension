{
  "name": "publish-browser-extension",
  "description": "Easily publish web extensions to their stores",
  "version": "6.1.1",
  "type": "module",
  "scripts": {
    "check": "check",
    "build": "bun run --sequential 'build:*'",
    "build:lib": "tsdown src/index.ts src/cli.ts --deps.onlyBundle superstruct",
    "build:test-extension": "bun scripts/build-test-extension.ts",
    "dev:all": "bun ./scripts/dev.ts all",
    "dev:chrome": "bun ./scripts/dev.ts chrome",
    "dev:firefox": "bun ./scripts/dev.ts firefox",
    "dev:edge": "bun ./scripts/dev.ts edge",
    "dev:opera": "bun ./scripts/dev.ts opera",
    "dev:help": "bun ./scripts/dev.ts help",
    "publish-extension": "bun src/cli.ts",
    "prepack": "bun run build",
    "prepare": "simple-git-hooks",
    "gen": "bun run --sequential 'gen:*'",
    "gen:config-docs": "bun run scripts/gen-config-docs.ts",
    "gen:config-env": "bun run scripts/gen-config-env.ts",
    "gen:resolve-config": "bun run scripts/gen-resolve-config.ts",
    "gen:cli-flags": "bun run scripts/gen-cli-flags.ts",
    "gen:config-from-flags": "bun run scripts/gen-config-from-flags.ts",
    "gen:cws-v1.1": "bun run scripts/gen-cws-api.ts v1.1",
    "gen:cws-v2": "bun run scripts/gen-cws-api.ts v2"
  },
  "dependencies": {
    "@topcli/prompts": "^4.0.0",
    "cac": "^7.0.0",
    "tasuku": "^2.3.0"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.4.0",
    "@aklinker1/zero-zip": "^1.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260705.1",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.72.0",
    "prettier": "^3.9.4",
    "publint": "^0.3.21",
    "scule": "^1.3.0",
    "simple-git-hooks": "^2.13.1",
    "superstruct": "^2.0.2",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "license": "MIT",
  "keywords": [
    "chrome-web-store",
    "firefox-addon-store",
    "chrome",
    "firefox",
    "addon",
    "store",
    "extension",
    "browser"
  ],
  "author": {
    "name": "Aaron Klinker",
    "url": "https://github.com/aklinker1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aklinker1/publish-browser-extension.git"
  },
  "homepage": "https://github.com/aklinker1/publish-browser-extension#readme",
  "files": [
    "dist"
  ],
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "publish-extension": "bin/publish-extension.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "default": "./dist/cli.mjs"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
