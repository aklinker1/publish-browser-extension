{
  "name": "publish-browser-extension",
  "description": "Easily publish web extensions to their stores",
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "check": "check",
    "build": "run-s build:*",
    "build:lib": "tsdown src/index.ts src/cli.ts --inlineOnly superstruct",
    "build:test-extension": "bun scripts/build-test-extension.js",
    "dev:all": "bun ./scripts/dev.mjs all",
    "dev:chrome": "bun ./scripts/dev.mjs chrome",
    "dev:firefox": "bun ./scripts/dev.mjs firefox",
    "dev:edge": "bun ./scripts/dev.mjs edge",
    "dev:opera": "bun ./scripts/dev.mjs opera",
    "dev:help": "bun ./scripts/dev.mjs help",
    "publish-extension": "bun src/cli.ts",
    "prepack": "bun run build",
    "prepare": "simple-git-hooks",
    "gen": "bun run --sequential 'gen:*'",
    "gen:config-docs": "bun run scripts/gen-config-docs.ts",
    "gen:config-env": "bun run scripts/gen-config-env.ts",
    "gen:resolve-config": "bun run scripts/gen-resolve-config.ts",
    "gen:cli-flags": "bun run scripts/gen-cli-flags.ts",
    "gen:config-from-flags": "bun run scripts/gen-config-from-flags.ts",
    "gen:cws-v1.1": "bun run scripts/gen-cws-api.ts v1.1",
    "gen:cws-v2": "bun run scripts/gen-cws-api.ts v2"
  },
  "dependencies": {
    "@topcli/prompts": "^3.1.0",
    "cac": "^6.7.14",
    "form-data-encoder": "^4.1.0",
    "formdata-node": "^6.0.3",
    "tasuku": "^2.3.0"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.2.2",
    "@typescript/native-preview": "^7.0.0-dev.20260208.1",
    "archiver": "^7.0.1",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.43.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.17",
    "scule": "^1.3.0",
    "simple-git-hooks": "^2.13.1",
    "superstruct": "^2.0.2",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "license": "MIT",
  "keywords": [
    "chrome-web-store",
    "firefox-addon-store",
    "chrome",
    "firefox",
    "addon",
    "store",
    "extension",
    "browser"
  ],
  "author": {
    "name": "Aaron Klinker",
    "url": "https://github.com/aklinker1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aklinker1/publish-browser-extension.git"
  },
  "homepage": "https://github.com/aklinker1/publish-browser-extension#readme",
  "files": [
    "dist"
  ],
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "publish-extension": "bin/publish-extension.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "default": "./dist/cli.mjs"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
